{
  "format": "layercake-generic-domain-authoring-config/1",
  "domain_id": "sql",
  "description": "SQLite-compatible read-only query generation checked by executing every held-out query against an isolated in-memory database.",
  "data_seed": 5150,
  "rows_per_family": {
    "train": 128,
    "validation": 16,
    "test": 16
  },
  "families": [
    {
      "id": "select_column",
      "prompt_templates": [
        "Return one SQL query only. Read exact column {column} from exact table {table}.",
        "Write SQL only: retrieve every {column} value stored in {table}."
      ],
      "response_template": "SELECT {column} FROM {table};",
      "copy_slots": [
        "table",
        "column"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({column} INTEGER)",
          "INSERT INTO {table} VALUES (3), (8), (13)"
        ],
        "expected_rows": [
          [
            3
          ],
          [
            8
          ],
          [
            13
          ]
        ]
      }
    },
    {
      "id": "where_equal",
      "prompt_templates": [
        "Return SQL only. From table {table}, select {selected} where {filtered} equals the exact text {match}.",
        "Write one query only: read {selected} in {table} for rows whose {filtered} value is {match}."
      ],
      "response_template": "SELECT {selected} FROM {table} WHERE {filtered} = '{match}';",
      "copy_slots": [
        "table",
        "selected",
        "filtered",
        "match"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({selected} INTEGER, {filtered} TEXT)",
          "INSERT INTO {table} VALUES (4, '{match}'), (9, 'other_value')"
        ],
        "expected_rows": [
          [
            4
          ]
        ]
      }
    },
    {
      "id": "order_descending",
      "prompt_templates": [
        "Return SQL only. Select {selected} from {table} ordered by {ordering} descending.",
        "Write one query only: read {selected} in {table}, sorting highest {ordering} first."
      ],
      "response_template": "SELECT {selected} FROM {table} ORDER BY {ordering} DESC;",
      "copy_slots": [
        "table",
        "selected",
        "ordering"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({selected} TEXT, {ordering} INTEGER)",
          "INSERT INTO {table} VALUES ('low', 1), ('high', 9), ('middle', 4)"
        ],
        "expected_rows": [
          [
            "high"
          ],
          [
            "middle"
          ],
          [
            "low"
          ]
        ]
      }
    },
    {
      "id": "count_threshold",
      "prompt_templates": [
        "Return SQL only. Count rows in {table} whose {column} value is at least 5.",
        "Write one query only: from {table}, count records where {column} is greater than or equal to 5."
      ],
      "response_template": "SELECT COUNT(*) FROM {table} WHERE {column} >= 5;",
      "copy_slots": [
        "table",
        "column"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({column} INTEGER)",
          "INSERT INTO {table} VALUES (2), (5), (7), (11)"
        ],
        "expected_rows": [
          [
            3
          ]
        ]
      }
    },
    {
      "id": "group_count",
      "prompt_templates": [
        "Return SQL only. Group table {table} by {category} and return each category with its row count, ordered by that category.",
        "Write one query only: count rows per {category} in {table}, sorting by the category value."
      ],
      "response_template": "SELECT {category}, COUNT(*) FROM {table} GROUP BY {category} ORDER BY {category};",
      "copy_slots": [
        "table",
        "category"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({category} TEXT)",
          "INSERT INTO {table} VALUES ('blue'), ('red'), ('blue')"
        ],
        "expected_rows": [
          [
            "blue",
            2
          ],
          [
            "red",
            1
          ]
        ]
      }
    },
    {
      "id": "distinct_ordered",
      "prompt_templates": [
        "Return SQL only. Select distinct {column} values from {table} in ascending order.",
        "Write one query only: deduplicate {column} in {table} and sort the result ascending."
      ],
      "response_template": "SELECT DISTINCT {column} FROM {table} ORDER BY {column} ASC;",
      "copy_slots": [
        "table",
        "column"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({column} INTEGER)",
          "INSERT INTO {table} VALUES (4), (1), (4), (2)"
        ],
        "expected_rows": [
          [
            1
          ],
          [
            2
          ],
          [
            4
          ]
        ]
      }
    },
    {
      "id": "inner_join",
      "prompt_templates": [
        "Return SQL only. Join {lefttable} to {righttable} where {leftkey} equals {rightkey}, and select {valuecolumn}.",
        "Write one inner-join query only: connect {lefttable}.{leftkey} with {righttable}.{rightkey} and return {valuecolumn}."
      ],
      "response_template": "SELECT {valuecolumn} FROM {lefttable} JOIN {righttable} ON {lefttable}.{leftkey} = {righttable}.{rightkey};",
      "copy_slots": [
        "lefttable",
        "righttable",
        "leftkey",
        "rightkey",
        "valuecolumn"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {lefttable} ({leftkey} INTEGER)",
          "CREATE TABLE {righttable} ({rightkey} INTEGER, {valuecolumn} TEXT)",
          "INSERT INTO {lefttable} VALUES (1), (3)",
          "INSERT INTO {righttable} VALUES (1, 'matched'), (2, 'ignored')"
        ],
        "expected_rows": [
          [
            "matched"
          ]
        ]
      }
    },
    {
      "id": "limit_rows",
      "prompt_templates": [
        "Return SQL only. Select {column} from {table} in ascending order and limit the result to two rows.",
        "Write one query only: read {column} in {table}, sort ascending, and keep the first 2 records."
      ],
      "response_template": "SELECT {column} FROM {table} ORDER BY {column} ASC LIMIT 2;",
      "copy_slots": [
        "table",
        "column"
      ],
      "evaluation": {
        "kind": "sqlite_query",
        "setup": [
          "CREATE TABLE {table} ({column} INTEGER)",
          "INSERT INTO {table} VALUES (8), (2), (5), (1)"
        ],
        "expected_rows": [
          [
            1
          ],
          [
            2
          ]
        ]
      }
    }
  ]
}
